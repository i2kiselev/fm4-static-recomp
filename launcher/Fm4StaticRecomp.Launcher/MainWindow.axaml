<!-- Adapted from Pinyon Shift's launcher (launcher/PinyonShift.Launcher.Desktop, BSD-3-Clause; see THIRD_PARTY_NOTICES.md). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Fm4StaticRecomp.Launcher.Controls"
        x:Class="Fm4StaticRecomp.Launcher.MainWindow"
        Title="FM4 Static Recomp" Icon="/Assets/launcher.ico" Width="1180" Height="760" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">
    <Grid RowDefinitions="64,*,48">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" Margin="64,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="ProductText" Classes="header" Text="FM4 STATIC RECOMP" VerticalAlignment="Center"/>
            <Border x:Name="GameBadge" IsVisible="False" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                    Padding="10,3" VerticalAlignment="Center">
                <TextBlock Text="PROJECT FORZA PLUS 4 1.3" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource LabelBrush}"/>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="BodyScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="64,16,64,40" MaxWidth="900" HorizontalAlignment="Left" Spacing="0">
                <controls:VectorHeading x:Name="Headline" Text="BUILD YOUR COPY" FontSize="46"
                                        Foreground="{StaticResource LabelBrush}"/>
                <TextBlock x:Name="Subhead" Margin="0,10,0,0" FontSize="17" TextWrapping="Wrap"
                           Foreground="{StaticResource ValueBrush}"
                           Text="Verified, extracted and compiled on this computer. Nothing is uploaded."/>

                <!-- The setup steps (spec 5); a retry resumes at the first step not done. -->
                <Border x:Name="SetupPanel" Classes="strip" Margin="0,28,0,0">
                    <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="34,*">
                            <TextBlock x:Name="GameMark" Classes="mark" Text="○"/>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock x:Name="GameTitle" Classes="stepTitle" Text="GAME"/>
                                <TextBlock x:Name="GameDetail" Classes="help" TextWrapping="Wrap"/>
                                <WrapPanel x:Name="GameChoices">
                                    <RadioButton x:Name="VanillaChoice" GroupName="Game" Content="VANILLA" IsChecked="True"
                                                 IsCheckedChanged="Game_Changed" Margin="0,0,18,0"/>
                                    <RadioButton x:Name="Pfp4Choice" GroupName="Game" Content="PROJECT FORZA PLUS 4"
                                                 IsCheckedChanged="Game_Changed"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="34,*">
                            <TextBlock x:Name="Disc1Mark" Classes="mark" Text="○"/>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock x:Name="Disc1Title" Classes="stepTitle" Text="DISC 1"/>
                                <TextBlock x:Name="Disc1Detail" Classes="help" TextWrapping="Wrap"/>
                                <WrapPanel x:Name="Disc1Buttons">
                                    <Button x:Name="BrowseButton" Classes="quiet" Content="CHOOSE DISC IMAGE"
                                            Click="Browse_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BrowseFolderButton" Classes="quiet" Content="CHOOSE FOLDER"
                                            Click="BrowseFolder_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="ModRow" ColumnDefinitions="34,*" IsVisible="False">
                            <TextBlock x:Name="ModMark" Classes="mark" Text="○"/>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock x:Name="ModTitle" Classes="stepTitle" Text="PROJECT FORZA PLUS 4 1.3"/>
                                <TextBlock x:Name="ModDetail" Classes="help" TextWrapping="Wrap"/>
                                <WrapPanel x:Name="ModButtons">
                                    <Button x:Name="BrowseModButton" Classes="quiet" Content="CHOOSE ZIP"
                                            Click="BrowseMod_Click" Margin="0,0,10,0"
                                            ToolTip.Tip="The mod's zip as downloaded."/>
                                    <Button x:Name="BrowseModFolderButton" Classes="quiet" Content="CHOOSE FOLDER"
                                            Click="BrowseModFolder_Click"
                                            ToolTip.Tip="The extracted Project Forza Plus 4 folder."/>
                                </WrapPanel>
                                <WrapPanel x:Name="ModOptions">
                                    <ComboBox x:Name="ModeCombo" Width="220" Margin="0,0,18,0" VerticalAlignment="Center"
                                              AutomationProperties.Name="Career mode"/>
                                    <CheckBox x:Name="HarderAiCheck" AutomationProperties.Name="Harder AI">
                                        <TextBlock Text="HARDER AI"/>
                                    </CheckBox>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="Disc2Row" ColumnDefinitions="34,*">
                            <TextBlock x:Name="Disc2Mark" Classes="mark" Text="○"/>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock x:Name="Disc2Title" Classes="stepTitle" Text="DISC 2 (OPTIONAL)"/>
                                <TextBlock x:Name="Disc2Detail" Classes="help" TextWrapping="Wrap"/>
                                <WrapPanel x:Name="Disc2Buttons">
                                    <Button x:Name="BrowseDisc2Button" Classes="quiet" Content="CHOOSE DISC 2"
                                            Click="BrowseDisc2_Click" Margin="0,0,10,0"
                                            ToolTip.Tip="A Disc 2 image (ISO)."/>
                                    <Button x:Name="BrowseDisc2FolderButton" Classes="quiet" Content="CHOOSE DISC 2 FOLDER"
                                            Click="BrowseDisc2Folder_Click" Margin="0,0,10,0"
                                            ToolTip.Tip="A GOD folder or a folder holding the four Disc 2 packages."/>
                                    <Button x:Name="Disc2LaterButton" Classes="quiet" Content="LATER" Click="Disc2Later_Click"
                                            ToolTip.Tip="Install Disc 2 later from Content."/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="LicenceRow" ColumnDefinitions="34,*">
                            <TextBlock x:Name="LicenceMark" Classes="mark" Text="○"/>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock x:Name="LicenceTitle" Classes="stepTitle" Text="MICROSOFT LICENCE"/>
                                <TextBlock x:Name="LicenceDetail" Classes="help" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="34,*">
                            <TextBlock x:Name="BuildMark" Classes="mark" Text="○"/>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock x:Name="BuildTitle" Classes="stepTitle" Text="BUILD"/>
                                <TextBlock x:Name="BuildDetail" Classes="help" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="34,*">
                            <TextBlock x:Name="ProfileMark" Classes="mark" Text="○"/>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock x:Name="ProfileTitle" Classes="stepTitle" Text="YOUR PROFILE"/>
                                <TextBlock x:Name="ProfileDetail" Classes="help" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <TextBox x:Name="ProfileNameBox" MaxLength="32" Width="360" HorizontalAlignment="Left" AutomationProperties.Name="Profile name"
                                             Watermark="Profile name" TextChanged="ProfileName_Changed" Margin="0,0,10,0"/>
                                    <Button x:Name="ChooseSetupSaveButton" Classes="quiet" Content="CHOOSE EXISTING SAVE…"
                                            Click="ChooseSetupSave_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="ClearSetupSaveButton" Classes="quiet" Content="NEW CAREER"
                                            Click="ClearSetupSave_Click" IsVisible="False"/>
                                </WrapPanel>
                                <ComboBox x:Name="StartCombo" Width="360" IsVisible="False" SelectedIndex="0"
                                          AutomationProperties.Name="How the career starts">
                                    <ComboBoxItem Content="NEW CAREER"/>
                                    <ComboBoxItem Content="SKIP INTRO SAVE"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource LineBrush}"/>
                        <TextBlock x:Name="InstallText" Classes="help" TextWrapping="Wrap"/>
                        <CheckBox x:Name="OwnershipCheck" AutomationProperties.Name="I own this copy" IsCheckedChanged="Ownership_Changed">
                            <TextBlock Text="I own this copy and dumped it from my own disc." TextWrapping="Wrap"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <WrapPanel Margin="0,28,0,0">
                    <Button x:Name="PrimaryButton" Classes="primary" Content="VERIFY AND BUILD"
                            Click="Primary_Click" IsEnabled="False" Margin="0,0,14,10"/>
                    <Button x:Name="AltButton" Classes="quiet" IsVisible="False" Click="Alt_Click"
                            VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="0,0,14,10"/>
                    <!-- The profile picker beside Play (spec 7). -->
                    <ComboBox x:Name="ProfileCombo" IsVisible="False" MinWidth="220" VerticalAlignment="Stretch"
                              VerticalContentAlignment="Center" Margin="0,0,10,10" FontSize="18"
                              AutomationProperties.Name="Profile" SelectionChanged="ProfileCombo_Changed"/>
                    <Button x:Name="ProfileButton" Classes="quiet" Content="PROFILE" IsVisible="False"
                            VerticalAlignment="Stretch" VerticalContentAlignment="Center" Margin="0,0,14,10">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="NEW" Click="NewProfile_Click"/>
                                <MenuItem Header="RENAME" Click="RenameProfile_Click"/>
                                <MenuItem Header="OPEN SAVE FOLDER" Click="OpenSaveFolder_Click"/>
                                <MenuItem Header="IMPORT SAVE" Click="ImportSave_Click"/>
                                <MenuItem Header="DELETE" Click="DeleteProfile_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </WrapPanel>

                <!-- One panel at a time below Play. -->
                <WrapPanel x:Name="NavPanel" IsVisible="False" Margin="0,4,0,0">
                    <Button x:Name="ContentButton" Classes="quiet nav" Content="CONTENT" Click="ContentButton_Click"
                            ToolTip.Tip="Disc 2, your downloadable content and the unicorn cars."/>
                    <Button x:Name="GraphicsButton" Classes="quiet nav" Content="GRAPHICS" Click="GraphicsButton_Click"
                            ToolTip.Tip="The game's graphics settings."/>
                    <Button x:Name="SettingsButton" Classes="quiet nav" Content="SETTINGS" Click="SettingsButton_Click"
                            ToolTip.Tip="Language, launch options and advanced options."/>
                    <Button x:Name="ControlsButton" Classes="quiet nav" Content="CONTROLS" Click="ControlsButton_Click"
                            ToolTip.Tip="The keyboard's keys and how fast they ramp."/>
                </WrapPanel>

                <TextBlock x:Name="StatusText" Margin="0,12,0,0" FontSize="15" TextWrapping="Wrap"
                           Foreground="{StaticResource ValueBrush}"/>

                <!-- A caught crash. -->
                <Border x:Name="CrashPanel" Classes="strip" IsVisible="False" BorderBrush="{StaticResource AccentBrush}">
                    <StackPanel Spacing="14">
                        <TextBlock TextWrapping="Wrap" LineHeight="21" Foreground="{StaticResource ValueBrush}"
                                   Text="A privacy-safe diagnostic ZIP is ready. REPORT CRASH opens a prefilled GitHub issue and shows the ZIP to attach. It holds no game files, saves, generated code or memory dump."/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="CRASH ID" Classes="header" VerticalAlignment="Center"/>
                            <SelectableTextBlock x:Name="CrashIdText" FontFamily="monospace" FontSize="13"
                                                 Foreground="{StaticResource LabelBrush}" Text="pending"/>
                        </StackPanel>
                        <WrapPanel>
                            <Button Classes="quiet" Content="DISMISS" Click="DismissCrash_Click"
                                    ToolTip.Tip="Keep the report in the reports folder and return to Play."/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Disc 2 and DLC, installed once for every profile (spec 6). -->
                <Border x:Name="ContentPanel" Classes="strip" IsVisible="False">
                    <StackPanel Spacing="12">
                        <controls:VectorHeading Text="CONTENT" FontSize="24" Foreground="{StaticResource LabelBrush}"/>
                        <TextBlock Classes="header" Text="DISC 2"/>
                        <TextBlock x:Name="Disc2StatusText"/>
                        <WrapPanel x:Name="Disc2AddButtons" IsEnabled="False">
                            <Button Classes="quiet" Content="ADD DISC 2…" Click="AddDisc2_Click" Margin="0,0,10,8"
                                    ToolTip.Tip="A Disc 2 image (ISO)."/>
                            <Button Classes="quiet" Content="ADD DISC 2 FOLDER…" Click="AddDisc2Folder_Click" Margin="0,0,10,8"
                                    ToolTip.Tip="A GOD folder or a folder holding the four Disc 2 packages."/>
                        </WrapPanel>
                        <Button x:Name="ChooseModAgainButton" Classes="quiet" Content="CHOOSE THE MOD AGAIN…" Click="ChooseModAgain_Click"
                                Margin="0,0,10,8" IsEnabled="False"
                                ToolTip.Tip="Copies Project Forza Plus 4 over the game again and saves every career mode's files again. Needs the mod's zip or folder."/>
                        <TextBlock Classes="header" Text="DOWNLOADABLE CONTENT" Margin="0,8,0,0"/>
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="DlcList" Spacing="4"/>
                        </ScrollViewer>
                        <WrapPanel x:Name="DlcAddButtons" IsEnabled="False">
                            <Button Classes="quiet" Content="ADD DLC FILES…" Click="AddDlcFiles_Click" Margin="0,0,10,8"/>
                            <Button Classes="quiet" Content="ADD DLC FOLDER…" Click="AddDlcFolder_Click" Margin="0,0,10,8"
                                    ToolTip.Tip="Every FM4 package in the folder and its subfolders."/>
                        </WrapPanel>
                        <TextBlock x:Name="ContentDropHelp" Classes="help" TextWrapping="Wrap"
                                   Text="Or drop packages or a folder on this window. Content is installed once and every profile sees it."/>
                        <TextBlock Classes="header" Text="UNICORN CARS" Margin="0,8,0,0"/>
                        <TextBlock x:Name="UnicornStatusText" TextWrapping="Wrap"/>
                        <Button x:Name="UnlockUnicornsButton" Classes="quiet" Content="UNLOCK UNICORN CARS…" Click="UnlockUnicorns_Click"
                                Margin="0,0,10,8" IsEnabled="False" HorizontalAlignment="Left"
                                ToolTip.Tip="Makes the unicorn cars buyable in the Autoshow for every profile of this install."/>
                        <StackPanel x:Name="ContentLines" Spacing="2"/>
                    </StackPanel>
                </Border>

                <Border x:Name="SettingsPanel" Classes="strip" IsVisible="False">
                    <StackPanel x:Name="SettingsBody" Spacing="12"/>
                </Border>

                <Border x:Name="ControlsPanel" Classes="strip" IsVisible="False">
                    <StackPanel x:Name="ControlsBody" Spacing="10"/>
                </Border>

                <!-- Progress and the log. -->
                <Border x:Name="ProgressPanel" Classes="strip" IsVisible="False" Padding="22,18">
                    <StackPanel Spacing="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" x:Name="PercentText" FontSize="14"
                                       Foreground="{StaticResource ValueBrush}"/>
                            <TextBlock x:Name="ProgressMessage" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="6" CornerRadius="0"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource SliderLowBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="DetailsButton" Classes="link" Content="SHOW DETAILS" Click="Details_Click"/>
                            <Button x:Name="CancelButton" Classes="link" Content="CANCEL" Click="Cancel_Click"/>
                        </StackPanel>
                        <TextBox x:Name="LogBox" IsVisible="False" IsReadOnly="True" Height="220"
                                 FontFamily="monospace" FontSize="11.5" TextWrapping="NoWrap"
                                 Background="#0A0A0A" BorderThickness="0" Foreground="{StaticResource ValueBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Background="#0A0A0A" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" x:Name="VersionText" Margin="40,0,0,0" VerticalAlignment="Center"
                       FontSize="13" Foreground="{StaticResource HelpBrush}" TextTrimming="CharacterEllipsis"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,32,0" VerticalAlignment="Center">
                <TextBlock x:Name="UpdateNote" FontSize="13" Foreground="{StaticResource HelpBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="UpdateButton" Classes="link" IsVisible="False" Click="Update_Click"
                        Foreground="{StaticResource AccentBrush}"/>
                <Button x:Name="GoBackButton" Classes="link" IsVisible="False" Click="GoBack_Click"/>
                <Button x:Name="CheckUpdatesButton" Classes="link" Content="CHECK FOR UPDATES" Click="CheckUpdates_Click"/>
                <Button x:Name="SavesButton" Classes="link" Content="SAVES" Click="Saves_Click"/>
                <Button x:Name="LogsButton" Classes="link" Content="LOGS" Click="Logs_Click"/>
                <Button x:Name="ReportButton" Classes="link" Content="REPORT A PROBLEM" Click="Report_Click"/>
                <Button Classes="link" Content="GITHUB" Click="GitHub_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Shown while a disc image, folder or DLC is dragged over the window. -->
        <Border x:Name="DropOverlay" Grid.RowSpan="3" Background="{StaticResource BackdropBrush}" IsVisible="False"
                IsHitTestVisible="False">
            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Margin="40">
                <TextBlock x:Name="DropOverlayText" Text="DROP TO USE THIS DISC" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Border>
    </Grid>
</Window>
